# Token del bot de Telegram (@BotFather)
TELEGRAM_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Google OAuth Credentials (Google Cloud Console → Credenciales)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# URL publica para OAuth callback (si corre en local, puede ser http://localhost:5000)
# IMPORTANTE: si la app corre en tu PC, usa http://localhost:5000
# Si despliega en cloud, usa la URL real (ej: https://marco-notas-bot.fly.dev)
BASE_URL=http://localhost:5000

# Clave de cifrado para los tokens OAuth (output de: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=
